{
  "name": "ia-fimap",
  "version": "1.0.0",
  "private": true,
  "description": "Assistente financeira FIMAP: interface web e API Cloudflare Workers AI",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "start": "npm run dev",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.cjs",
    "test:live": "node scripts/test-live.cjs",
    "typecheck": "tsc --noEmit",
    "cf:whoami": "wrangler whoami",
    "doctor": "node scripts/doctor.cjs",
    "doctor:live": "node scripts/doctor.cjs --live",
    "ai:configure": "node scripts/configure-ai.cjs",
    "check": "npm run typecheck && npm test && npm run build",
    "predev": "node scripts/doctor.cjs",
    "pretest": "node scripts/doctor.cjs",
    "pretypecheck": "node scripts/doctor.cjs",
    "prebuild": "node scripts/doctor.cjs",
    "pretest:browser": "node scripts/doctor.cjs",
    "pretest:live": "node scripts/doctor.cjs",
    "predeploy": "npm run check",
    "postdeploy": "npm run doctor:live"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "wrangler": "4.160.0"
  }
}
