{
  "name": "ia-fimap",
  "version": "1.0.0",
  "private": true,
  "description": "Assistente financeira FIMAP: interface web e API Cloudflare Workers AI",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "start": "npm run dev",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.cjs",
    "test:live": "node scripts/test-live.cjs",
    "typecheck": "tsc --noEmit",
    "ui:dev": "npm run dev",
    "ui:build": "npm run build",
    "ui:deploy": "npm run deploy",
    "cf:whoami": "wrangler whoami"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "wrangler": "4.160.0"
  }
}
