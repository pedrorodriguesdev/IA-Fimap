# Conta provedora da IA; nunca preencha este arquivo versionado.
# Copie para .dev.vars e configure os valores somente nessa cópia.
AI_PROVIDER_ACCOUNT_ID=
AI_PROVIDER_API_TOKEN=
# Integração com o back-end e serviços opcionais.
CHAT_API_TOKEN=
TAVILY_API_KEY=
BRAPI_TOKEN=
HG_BRASIL_API_KEY=
GEOAPIFY_API_KEY=
# Domínios adicionais autorizados no navegador, separados por vírgula.
# O próprio domínio do Worker já é permitido.
ALLOWED_ORIGINS=
